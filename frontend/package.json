{
  "name": "radiohub-oberflaeche",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "vite build && node node_modules/appkern-oberflaeche/oberflaeche/werkzeuge/symbol-einbetten.mjs dist",
    "build:web": "vite build --mode web && node node_modules/appkern-oberflaeche/oberflaeche/werkzeuge/symbol-einbetten.mjs dist-web",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/orbitron": "^5.2.8",
    "appkern-oberflaeche": "github:HalloWelt42/appkern#527bd91a9222843815dc9f6f7b91c20b1b804600",
    "hls.js": "^1.5.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^4.0.18"
  }
}
