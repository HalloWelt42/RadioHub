{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["svelte"],
    "paths": { "$ziel/*": ["./src/ziel/voll/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"]
}
