# Vorschaltdienst wie bei Kellerwolke und Transkription: TLS mit dem Blattzertifikat der Hausstelle und HTTP/2 auf
# 9093, dahinter die Oberfläche (nginx, Port 80 im Netz von compose). HTTPS braucht das Telefon für Bildschirm wach
# halten und als Web-App. Beim Zugriff per IP steht kein Servername im Handschlag, darum default_sni: radiohub.local
# steht in jedem Zertifikat (tools/zertifikat.sh nimmt es immer auf). Kein HSTS: unter einem Rechnernamen würde es
# alle Ports des Rechners auf HTTPS zwingen. Die Adresse über http (9092) bleibt.
{
	admin off
	auto_https off
	default_sni radiohub.local
}

:9093 {
	tls /zertifikate/radiohub.pem /zertifikate/radiohub-schluessel.pem
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	# Ton und Ereignisströme gehen ungepuffert durch
	reverse_proxy radiohub-frontend:80 {
		flush_interval -1
	}
}
